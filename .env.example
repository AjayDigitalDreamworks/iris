# ─────────────────────────────────────────────────────────────────────────────
# IRIS — example environment file.  COPY TO `.env` AND FILL IN.
#   cp .env.example .env
# NEVER commit a real `.env`. It is listed in .gitignore.
# Placeholders only — no real credentials in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ─────────────────────────────────────────────────────────────────
IRIS_ENV=development                 # development | test | production
IRIS_DEBUG=false

# ── API server ──────────────────────────────────────────────────────────────
IRIS_API_HOST=127.0.0.1
IRIS_API_PORT=8000
IRIS_API_WORKERS=1
# Comma-separated origins allowed to call the API.
IRIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ────────────────────────────────────────────────────────────────
# Local prototype:
IRIS_DATABASE_URL=sqlite:///./data/iris.db
# Production (PostgreSQL) — see docs/DEPLOYMENT.md:
# IRIS_DATABASE_URL=postgresql+psycopg://iris:CHANGE_ME@localhost:5432/iris
IRIS_DB_ECHO=false
IRIS_DB_POOL_SIZE=5

# ── Paths ───────────────────────────────────────────────────────────────────
IRIS_DATA_DIR=./data
IRIS_MODEL_DIR=./models
IRIS_LOG_DIR=./logs
IRIS_CONFIG_DIR=./configs

# ── Logging ─────────────────────────────────────────────────────────────────
IRIS_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
IRIS_LOG_JSON=true                   # structured JSON logs (set false for readable console)
IRIS_LOG_MAX_BYTES=10485760
IRIS_LOG_BACKUP_COUNT=5

# ── Security ────────────────────────────────────────────────────────────────
# Generate with:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
IRIS_SECRET_KEY=CHANGE_ME_TO_A_32_BYTE_RANDOM_SECRET_STRING__
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
IRIS_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET__
IRIS_JWT_ALGORITHM=HS256
IRIS_JWT_EXPIRE_MINUTES=720
IRIS_PASSWORD_MIN_LENGTH=10
IRIS_RATE_LIMIT_PER_MINUTE=240
# Disable auth entirely — DEVELOPMENT ONLY. Must stay false in production.
IRIS_AUTH_ENABLED=false
IRIS_DEFAULT_ADMIN_USERNAME=admin
IRIS_DEFAULT_ADMIN_PASSWORD=CHANGE_ME_BEFORE_ANY_REAL_USE

# ── AI / inference ──────────────────────────────────────────────────────────
IRIS_DEVICE=auto                     # auto | cpu | cuda | mps | openvino
IRIS_CONFIDENCE_THRESHOLD=0.25       # detector confidence floor
IRIS_IOU_THRESHOLD=0.45              # NMS IoU
IRIS_DETECTOR_WEIGHTS=yolo11n.pt
IRIS_PERSON_WEIGHTS=yolo11n.pt       # yolo11n COCO already contains the 'person' class
IRIS_DETECTOR_IMGSZ=640
IRIS_TRACKER=bytetrack.yaml          # bytetrack.yaml | botsort.yaml
IRIS_TRACK_MAX_TTL_SECONDS=30        # expire anonymous tracks
IRIS_EMBEDDING_ENABLED=true
IRIS_EMBEDDING_MIN_SIMILARITY=0.35   # below this → 'unknown' product state
IRIS_MIN_DETECTION_CONFIDENCE=0.25

# ── Camera pipeline ─────────────────────────────────────────────────────────
IRIS_FRAME_QUEUE_SIZE=4              # bounded: stale frames are dropped
IRIS_FRAME_SKIP=1                    # process every Nth decoded frame
IRIS_DEFAULT_CAPTURE_FPS=5.0
IRIS_RTSP_CONNECT_TIMEOUT=10.0
IRIS_RTSP_RECONNECT_DELAY=5.0        # base seconds for bounded exponential backoff
IRIS_RTSP_RECONNECT_MAX_DELAY=120.0
IRIS_FROZEN_FRAME_SECONDS=15.0       # identical frames for this long ⇒ frozen stream
IRIS_CAMERA_STALE_SECONDS=60.0
IRIS_MJPEG_QUALITY=70
IRIS_MJPEG_MAX_CLIENTS=16
IRIS_MAX_UPLOAD_MB=512
IRIS_ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.webm,.m4v

# ── Business rules: DEFAULTS ONLY ───────────────────────────────────────────
# Every value below is the *default*; runtime values live in the `settings` table
# and are editable from the dashboard (Settings page) without a restart.
IRIS_DEFAULT_LOW_STOCK_THRESHOLD=20      # percent of shelf capacity
IRIS_DEFAULT_OUT_OF_STOCK_THRESHOLD=5    # percent of shelf capacity
IRIS_DEFAULT_QUEUE_BUSY=4               # people in queue zone ⇒ BUSY
IRIS_DEFAULT_QUEUE_CRITICAL=7           # people in queue zone ⇒ CRITICAL
IRIS_ALERT_COOLDOWN_SECONDS=300
IRIS_ALERT_REQUIRED_OBSERVATIONS=3       # stable observations before an alert fires
IRIS_ALERT_MIN_CONFIDENCE=0.80

# ── Privacy / retention ─────────────────────────────────────────────────────
IRIS_EVIDENCE_ENABLED=true
IRIS_EVIDENCE_RETENTION_DAYS=7
IRIS_DETECTION_RETENTION_DAYS=30
IRIS_ALERT_RETENTION_DAYS=365
IRIS_ANONYMIZE_FACES=true              # optional face blurring on stored evidence only

# ── Optional external services (unused in the local-first prototype) ────────
IRIS_REDIS_URL=
IRIS_MQTT_URL=

# ── Demo mode ───────────────────────────────────────────────────────────────
# DEMO MODE seeds explicitly-labelled synthetic fixtures so the UI can be shown
# without cameras. It never affects the real pipeline path.
IRIS_DEMO_MODE=false